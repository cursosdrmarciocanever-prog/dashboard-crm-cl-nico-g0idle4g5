# Copie para deploy/.env na VPS e ajuste. NAO commitar o .env real.

# Versao do PocketBase — DEVE bater com a do goskip (veja no rodape de /_/).
PB_VERSION=0.36.9
# Arquitetura do binario. VPS x86_64 = linux_amd64 (padrao). ARM = linux_arm64.
PB_ARCH=linux_amd64

# Dominio publico do CRM (front + API na mesma origem).
CRM_HOST=crm.clinicacanever.com.br
CRM_URL=https://crm.clinicacanever.com.br

# Nome do certresolver do SEU Traefik (copie do compose do app-financeiro).
CERT_RESOLVER=letsencrypt

# WhatsApp fallback (o valor oficial fica na colecao `settings`, editavel no app).
CLINIC_WHATSAPP=5544999999999

# --- Integracao WhatsApp (Evolution API) ---
# URL do gateway Evolution e a MESMA API key do deploy/evolution/.env.
EVOLUTION_URL=https://evo.clinicacanever.com.br
EVOLUTION_API_KEY=COPIE_DO_EVOLUTION_ENV
EVOLUTION_INSTANCE=clinica
# Segredo compartilhado que protege o webhook de captura de leads.
# Gere com: openssl rand -hex 16  (e use o MESMO valor na URL do webhook do Evolution)
WA_WEBHOOK_TOKEN=TROQUE_POR_UM_TOKEN

# --- Alerta de WhatsApp caído (Telegram) ---
# Opcionais: se vazios, o watchdog reaproveita o bot do Hermes
# (/docker/hermes-agent-vxrg/data/.env) e o chat 5691849297.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alerta de queda do WhatsApp (watchdog) ---
# Pelo menos UM canal precisa estar preenchido, senão ninguém é avisado quando
# o WhatsApp cair. Teste com: ./whatsapp-watchdog.sh --teste
#
# Telegram (recomendado): fale com @BotFather para criar o bot e pegar o token;
# depois mande uma mensagem para o seu bot e veja o seu id em
# https://api.telegram.org/bot<TOKEN>/getUpdates  (campo "chat":{"id":...})
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail (opcional, segundo canal). Com Gmail, use uma "senha de app".
ALERTA_EMAIL_TO=
SMTP_URL=smtps://smtp.gmail.com:465
SMTP_USER=
SMTP_PASS=
