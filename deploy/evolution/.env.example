# Copie para .env na VPS e ajuste. NAO commitar o .env real.

# Dominio publico do Evolution (API + manager).
EVO_HOST=evo.clinicacanever.com.br
EVO_URL=https://evo.clinicacanever.com.br

# Certresolver do Traefik (mesmo do CRM/financeiro).
CERT_RESOLVER=mytlschallenge

# Chave de acesso a API do Evolution. GERE uma forte:
#   openssl rand -hex 24
AUTHENTICATION_API_KEY=TROQUE_POR_UMA_CHAVE_FORTE

# Senha do PostgreSQL do Evolution. GERE uma forte:
#   openssl rand -hex 24
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
POSTGRES_USER=evolution
POSTGRES_DB=evolution
